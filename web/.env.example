NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Sentry — monitoramento de erros (frontend)
# Obtenha em sentry.io → seu projeto → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Ambiente visível no Sentry: development | staging | production
NEXT_PUBLIC_ENV=production
# Para upload de source maps no build (CI/CD)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
