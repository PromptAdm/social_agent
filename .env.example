# ─────────────────────────────────────────────────────────────────
# Social Agent — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do .env com dados reais.
# ─────────────────────────────────────────────────────────────────

# Aplicação
APP_NAME="Social Agent"
APP_VERSION="0.1.0"
DEBUG=false

# Banco de Dados PostgreSQL
# Formato: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://social_agent:secret@localhost:5432/social_agent

# JWT
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SEGURA_DE_64_CARACTERES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — origens permitidas (separadas por vírgula se múltiplas)
ALLOWED_ORIGINS=["http://localhost:3000"]
