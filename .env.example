# ─────────────────────────────────────────────────────────────────
# Social Agent — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do .env com dados reais.
# ─────────────────────────────────────────────────────────────────

# Aplicação
APP_NAME="Social Agent"
APP_VERSION="0.1.0"
DEBUG=false

# Banco de Dados PostgreSQL
# Formato: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://social_agent:secret@localhost:5432/social_agent

# JWT
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SEGURA_DE_64_CARACTERES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — origens permitidas (separadas por vírgula se múltiplas)
ALLOWED_ORIGINS=["http://localhost:3000"]

# IA — provedor de inteligência artificial
# Valores: mock | openai | anthropic | gemini
AI_PROVIDER=mock

# ── OAuth / Redirects ─────────────────────────────────────────────────────────
# URL base do frontend (usado para redirecionar após OAuth)
FRONTEND_URL=http://localhost:3000

# Chave de criptografia para tokens OAuth armazenados no banco.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Se vazio, derivado automaticamente de SECRET_KEY (não recomendado em produção).
ENCRYPTION_KEY=

# ── Meta (Facebook + Instagram) — OAuth + Webhooks ───────────────────────────
# Obtenha em developers.facebook.com → seu app → Configurações
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=social_agent_verify_token
# URI de callback OAuth — registre exatamente este valor no painel Meta:
# developers.facebook.com → Produtos → Login do Facebook → Configurações de OAuth do Cliente
META_REDIRECT_URI=http://localhost:8000/api/v1/integrations/meta/callback
# Legacy: token estático (substitua pelo fluxo OAuth acima em produção)
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_FACEBOOK_PAGE_ID=
META_API_VERSION=v21.0

# ── X (Twitter) — OAuth 2.0 PKCE ─────────────────────────────────────────────
# Obtenha em developer.twitter.com → seu app → Keys and Tokens
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# URI de callback OAuth — registre este valor no painel do app X:
# developer.twitter.com → seu app → Auth settings → Callback URLs
TWITTER_REDIRECT_URI=http://localhost:8000/api/v1/integrations/twitter/callback

# ── WhatsApp Business (Phase 2 — desabilitado por padrão) ────────────────────
WHATSAPP_ENABLED=false

# ── n8n — automação de workflows ─────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=https://n8n.yourdomain.com/webhook

# ── Better Stack — monitoramento de uptime ───────────────────────────────────
# Token de API: betterstack.com/users/api-tokens
# Execute: python scripts/setup_betterstack.py para criar todos os monitores
BETTERSTACK_API_TOKEN=
# URL gerada automaticamente ao criar o heartbeat monitor (via setup_betterstack.py)
BETTERSTACK_HEARTBEAT_URL=

# ── Sentry — monitoramento de erros e performance ────────────────────────────
# Obtenha o DSN em sentry.io → seu projeto → Settings → Client Keys
SENTRY_DSN=
# Ambiente: development | staging | production
SENTRY_ENVIRONMENT=production
# Fração de transações rastreadas para performance (0.0–1.0). 0.1 = 10%
SENTRY_TRACES_SAMPLE_RATE=0.1
# Limiar em ms para alertar sobre requests lentos (padrão: 2000 = 2s)
SENTRY_SLOW_REQUEST_MS=2000
