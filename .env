# ─────────────────────────────────────────────────────────────────
# Social Agent — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do .env com dados reais.
# ─────────────────────────────────────────────────────────────────

# Aplicação
APP_NAME="Social Agent"
APP_VERSION="0.1.0"
DEBUG=false

# Banco de Dados — SQLite para desenvolvimento local
DATABASE_URL=sqlite:///./social_agent.db

# JWT
SECRET_KEY=813aa1b8bc018cba04151f01f4eda9457a26fe1053291e30d5b9c9c0e7493891
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — origens permitidas (separadas por vírgula se múltiplas)
ALLOWED_ORIGINS=["http://localhost:3000"]

# Scheduler — publicação automática de posts agendados
# SCHEDULER_ENABLED=false  ← desabilitar em testes ou staging
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# IA — provedor de inteligência artificial
# Valores: mock | anthropic
# Para usar Claude: defina AI_PROVIDER=anthropic e adicione sua chave abaixo
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# Meta (Facebook/Instagram) — integrações
# Obtenha em developers.facebook.com → seu App → Instagram → Configurações
#
# META_ACCESS_TOKEN  : Page Access Token ou System User Token
#                      Scopes necessários: instagram_content_publish, pages_manage_posts
# META_IG_USER_ID    : ID numérico do Instagram Business Account
#                      Obtenha via GET /me/accounts ou Business Manager
# META_FACEBOOK_PAGE_ID : ID numérico da Facebook Page (para posts no Facebook)
# META_API_VERSION   : versão da Graph API (padrão: v21.0)
# META_APP_SECRET    : App Secret para verificar assinatura X-Hub-Signature-256
#
# Quando META_ACCESS_TOKEN + META_IG_USER_ID estiverem preenchidos,
# o sistema usa MetaPublisher (real). Caso contrário, usa o mock local.
META_WEBHOOK_VERIFY_TOKEN=social_agent_verify_token
META_APP_SECRET=
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_FACEBOOK_PAGE_ID=
META_API_VERSION=v21.0

# n8n — automação de workflows
# URL base dos webhooks configurados no n8n
N8N_WEBHOOK_BASE_URL=https://n8n.yourdomain.com/webhook
