tests/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Ferramentas de desenvolvimento ───────────────────────────────────────────
.git/
.gitignore
.github/
.mypy_cache/
.ruff_cache/

# ── Frontend (build separado no Vercel) ──────────────────────────────────────
web/

# ── IDE e OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ── Documentação e config de deploy (não necessários no container) ────────────
*.md
render.yaml
railway.toml
